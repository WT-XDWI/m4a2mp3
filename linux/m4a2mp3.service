[Unit]
Description=m4a2mp3 音频转 MP3 网页服务
After=network.target

[Service]
Type=simple
# 改成你实际运行服务的用户
User=dsh
Group=dsh
# 仓库解压后的根目录（index.html 所在处）
WorkingDirectory=/home/dsh/m4a2mp3
ExecStart=/usr/bin/python3 -u /home/dsh/m4a2mp3/linux/serve.py
Restart=always
RestartSec=5
StandardOutput=append:/home/dsh/m4a2mp3/serve.log
StandardError=append:/home/dsh/m4a2mp3/serve.log

[Install]
WantedBy=multi-user.target
